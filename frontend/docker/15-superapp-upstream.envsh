#!/bin/sh
# Diurai sebelum template nginx dirender (20-envsubst-on-templates.sh). File *.envsh di-"source" oleh entrypoint
# image nginx sehingga variabel yang di-export di sini ikut tersedia untuk envsubst.
#
# BACKEND_UPSTREAM (mis. http://backend:8000/api/ atau https://api.domain-anda.com/api/) dipecah menjadi:
#   BACKEND_ORIGIN = skema://host:port   -> proxy_pass memakai variabel, sehingga nama host di-resolve saat request.
#   BACKEND_PATH   = awalan path tujuan  -> /api/<sisa> diteruskan ke <BACKEND_PATH><sisa> (sama dengan perilaku
#                    proxy_pass ber-URI sebelumnya; tanpa path = URI asli /api/... diteruskan apa adanya).
# Dengan begitu nginx TETAP hidup walau backend belum bisa di-resolve (backend sedang redeploy / beda network di
# Coolify): permintaan /api/ sementara mendapat 502, bukan container mati dan healthcheck gagal.

bawaan="http://127.0.0.1:65535/api/"
u="${BACKEND_UPSTREAM:-$bawaan}"
skema="${u%%://*}"
case "$skema" in
  http|https) ;;
  *)
    echo "15-superapp-upstream: BACKEND_UPSTREAM tidak valid ('$u'), harus diawali http:// atau https://; memakai $bawaan" >&2
    u="$bawaan"; skema="http"
    ;;
esac
sisa="${u#*://}"
hostport="${sisa%%/*}"
case "$sisa" in
  */*) path="/${sisa#*/}" ;;
  *) path="/api/" ;;
esac
BACKEND_ORIGIN="$skema://$hostport"
BACKEND_PATH="$path"
export BACKEND_ORIGIN BACKEND_PATH

# DNS resolver untuk proxy_pass bervariabel: nameserver container (127.0.0.11 di network Docker/Coolify).
if [ -z "${NGINX_LOCAL_RESOLVERS:-}" ]; then
  NGINX_LOCAL_RESOLVERS=$(awk 'BEGIN{ORS=" "} $1=="nameserver" {if ($2 ~ ":") {print "["$2"]"} else {print $2}}' /etc/resolv.conf 2>/dev/null)
  NGINX_LOCAL_RESOLVERS="${NGINX_LOCAL_RESOLVERS% }"
fi
NGINX_LOCAL_RESOLVERS="${NGINX_LOCAL_RESOLVERS:-127.0.0.11}"
export NGINX_LOCAL_RESOLVERS

echo "15-superapp-upstream: /api/ -> ${BACKEND_ORIGIN}${BACKEND_PATH} (resolver ${NGINX_LOCAL_RESOLVERS})"
