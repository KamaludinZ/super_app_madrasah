# ============================================================
# FRONTEND PRODUCTION ENVIRONMENT CONFIGURATION
# Super Apps MATSANDATAMA - MTsN 2 Kota Malang
# ============================================================
#
# INSTRUKSI:
# 1. Copy file ini ke .env.production
# 2. Isi dengan URL backend production
# 3. Build dengan: npm run build
#
# ============================================================

# ============================================================
# BACKEND API URL
# ============================================================
# URL backend API (tanpa trailing slash)
# Production: Gunakan domain production
REACT_APP_BACKEND_URL=https://api.mtsn2kotamalang.sch.id

# Development/Testing: Uncomment line di bawah
# REACT_APP_BACKEND_URL=http://localhost:8000

# ============================================================
# APPLICATION INFO
# ============================================================
REACT_APP_NAME=Super Apps MATSANDATAMA
REACT_APP_VERSION=1.1.2

# ============================================================
# BUILD CONFIGURATION
# ============================================================
# Generate source maps (set to false for production)
GENERATE_SOURCEMAP=false

# Inline runtime chunk (recommended for production)
INLINE_RUNTIME_CHUNK=false

# ============================================================
# ENVIRONMENT FLAGS
# ============================================================
# Node environment (auto-set by build scripts)
# NODE_ENV=production

# ============================================================
# SECURITY NOTES
# ============================================================
#
# 1. File .env.production akan di-bundle ke dalam build
#    - Jangan simpan credentials sensitif di sini
#    - Hanya URL dan config non-sensitif
#
# 2. REACT_APP_BACKEND_URL:
#    - Harus HTTPS di production
#    - Pastikan CORS sudah dikonfigurasi di backend
#
# 3. Build production:
#    npm run build
#
#    Output di folder build/ siap deploy
#
# 4. Verify build:
#    - Check file size: build/static/js/main.*.js
#    - Check no console.log: grep -r "console.log" build/static/js/
#    - Test bundle: serve -s build
#
# ============================================================
