# ============================================================
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Super Apps MATSANDATAMA - MTsN 2 Kota Malang
# ============================================================
#
# INSTRUKSI:
# 1. Copy file ini ke .env (jangan commit .env ke git!)
# 2. Isi semua nilai dengan credentials production yang sebenarnya
# 3. Simpan dengan aman - file ini berisi informasi sensitif
#
# ============================================================

# ============================================================
# ENVIRONMENT & DEBUG
# ============================================================
# PENTING: Set ke production untuk disable debug mode
ENVIRONMENT=production

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Production harus WARNING atau ERROR
LOG_LEVEL=WARNING

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/matsandatama_production?retryWrites=true&w=majority

# Database name
MONGODB_DB_NAME=matsandatama_production

# ============================================================
# SECURITY & AUTHENTICATION
# ============================================================
# JWT Secret Key - HARUS KUAT DAN UNIQUE!
# Generate dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=YOUR_VERY_STRONG_SECRET_KEY_HERE_MINIMUM_32_CHARACTERS

# JWT Token Expiry (in minutes)
JWT_EXPIRY_MINUTES=480

# Session idle timeout (in minutes)
SESSION_IDLE_TIMEOUT=120

# Password reset token expiry (in minutes)
PASSWORD_RESET_EXPIRY=30

# ============================================================
# CORS CONFIGURATION
# ============================================================
# Comma-separated list of allowed origins
# Production: Gunakan domain production saja
CORS_ORIGINS=https://super.mtsn2kotamalang.sch.id,https://www.mtsn2kotamalang.sch.id

# Development: Boleh tambahkan localhost
# CORS_ORIGINS=https://super.mtsn2kotamalang.sch.id,http://localhost:3000

# ============================================================
# EMAIL CONFIGURATION
# ============================================================
# SMTP Server untuk password reset
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@mtsn2kotamalang.sch.id
SMTP_PASSWORD=YOUR_EMAIL_APP_PASSWORD_HERE

# Email sender info
EMAIL_FROM=noreply@mtsn2kotamalang.sch.id
EMAIL_FROM_NAME=Super Apps MATSANDATAMA

# ============================================================
# APPLICATION URLS
# ============================================================
# Backend API URL
BACKEND_URL=https://api.mtsn2kotamalang.sch.id

# Frontend URL (untuk email links)
FRONTEND_URL=https://super.mtsn2kotamalang.sch.id

# ============================================================
# FILE UPLOAD & STORAGE
# ============================================================
# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE_MB=10

# Upload directory (relative to backend/)
UPLOAD_DIR=uploads

# Static files URL prefix
STATIC_URL=/static

# ============================================================
# RATE LIMITING (Optional - if using)
# ============================================================
# Enable rate limiting
RATE_LIMIT_ENABLED=true

# Login attempts limit (per IP per 15 minutes)
LOGIN_RATE_LIMIT=5

# API requests limit (per IP per minute)
API_RATE_LIMIT=100

# ============================================================
# MONITORING & LOGGING (Optional)
# ============================================================
# Sentry DSN for error tracking (if using Sentry)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Application version
APP_VERSION=1.1.2

# ============================================================
# FEATURE FLAGS (Optional)
# ============================================================
# Enable/disable specific features
ENABLE_REGISTRATION=false
ENABLE_PASSWORD_RESET=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false

# ============================================================
# SECURITY NOTES
# ============================================================
#
# 1. JANGAN COMMIT FILE .env KE GIT!
#    File .env sudah ada di .gitignore
#
# 2. JWT_SECRET harus:
#    - Minimal 32 karakter
#    - Random dan unik
#    - Tidak boleh dibagikan
#    - Berbeda antara development dan production
#
# 3. MongoDB credentials:
#    - Gunakan MongoDB Atlas untuk production
#    - Enable IP whitelist
#    - Gunakan user dengan role minimal (bukan admin)
#    - Aktifkan encryption at rest
#
# 4. CORS_ORIGINS:
#    - Jangan gunakan '*' di production!
#    - Hanya list domain production yang valid
#
# 5. Email credentials:
#    - Gunakan app-specific password, bukan password utama
#    - Enable 2FA di email account
#
# 6. Backup .env file dengan aman:
#    - Simpan di password manager
#    - Atau encrypted storage
#    - JANGAN simpan di repo git atau public cloud
#
# ============================================================
