# .ngodingpakeaiignore — extra paths to keep out of NgodingPakeAI sync.
# Uses .gitignore syntax. Secrets, node_modules, build output and .env files
# are ALWAYS blocked by the CLI regardless of what is listed here.

# Examples:
# docs/internal/
# *.snap
# fixtures/

# Artefak hasil generate, cache tooling, backup, dan hasil test (bukan kode sumber)
.pytest_cache/
test_reports/
testsprite_tests/tmp/
.emergent/
.gradle/
.impeccable/
**/.impeccable/
*.backup
frontend/package-lock.json
openapi.json
**/.gitkeep

# Cache lokal Expo (berisi status dev server, bukan kode)
mobile/.expo/
mobile/yarn.lock
